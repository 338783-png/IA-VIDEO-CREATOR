# Copier ce fichier en .env et ajuster si besoin.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Limites d'import (Mo)
MAX_VIDEO_MB=2048
MAX_AUDIO_MB=300
MAX_IMAGE_MB=30

# Binaires (laisser tel quel s'ils sont dans le PATH)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# IA locale
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
